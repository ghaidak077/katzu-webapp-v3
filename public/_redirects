# The demo lesson was removed from the app: the free front door is /welcome.
/demo /welcome 301

# SPA routes. A static 404.html makes Cloudflare Pages answer every unmatched
# path with it, which would break React Router deep links — so the real
# client-side routes are rewritten to the shell first. The redirects above are
# deliberately listed before these, so an old public URL never reaches the SPA.
/app / 200
/app/* / 200
/main / 200
/main/* / 200
/scenario/* / 200
/welcome / 200
/signin / 200
/onboarding / 200
/subscription / 200
/paywall / 200
/mock / 200
/placement / 200
/session-report / 200
/delete-account / 200
