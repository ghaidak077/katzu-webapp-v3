/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # `same-origin` severs the opener relationship that Google Identity Services
  # needs to hand its credential back from the popup (and isolates the One Tap
  # iframe); the popup then closes without a token and sign-in looks broken.
  # `same-origin-allow-popups` keeps the isolation and keeps that one window.
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: microphone=(self), camera=(), geolocation=()
  # script-src: the built entry and the PWA registerSW are both external files,
  # and the Google Identity script is injected via a src= script element
  # (allowed by script-src's host source), so only real code sources can
  # execute. style-src keeps inline styles because the glass design system
  # renders ~30 dynamic CSS-custom-property style attributes (React style={{}})
  # — removing those is a tracked follow-up, not a loss of script protection.
  # Google's own button reads its font from fonts.gstatic.com and, in One Tap,
  # the account avatar from *.googleusercontent.com; both are exact hosts, so no
  # scheme-wide wildcard is introduced.
  # The Cloudflare Web Analytics beacon is injected by Pages into every HTML
  # response; without its host the browser blocks it and logs a CSP error on
  # each load. It is consent-free aggregate analytics, not app code, so it gets
  # its exact hosts (script + its RUM POST) and nothing wider.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com https://katzu-test.ghaidakalosh008.workers.dev https://cloudflareinsights.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self';

# Private app surfaces. The SPA shell is shared, so this HTTP header is the
# reliable signal; the static public pages carry their own index,follow meta.
/app/*
  X-Robots-Tag: noindex, nofollow

/onboarding
  X-Robots-Tag: noindex, nofollow

/signin
  X-Robots-Tag: noindex, nofollow

/paywall
  X-Robots-Tag: noindex, nofollow

/subscription
  X-Robots-Tag: noindex, nofollow
