{
  "name": "katzu-web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:types": "tsc -p e2e --noEmit",
    "lint": "tsc --noEmit",
    "design:audit": "node scripts/design-audit.mjs",
    "design:contrast": "node scripts/contrast-check.mjs",
    "design": "npm run design:audit && npm run design:contrast",
    "check:launch": "node scripts/check-launch.mjs",
    "make:share-image": "node scripts/make-share-image.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "measure:perf": "node scripts/measure-lighthouse.mjs",
    "check:launch:strict": "LAUNCH_STRICT=1 node scripts/check-launch.mjs",
    "session:start": "node scripts/session-start.mjs",
    "deploy:worker": "wrangler deploy",
    "tail:worker": "wrangler tail",
    "test:smoke:token-hygiene": "node scripts/smoke-token-hygiene.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.67.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^1.16.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.1",
    "workbox-window": "^7.3.0",
    "wrangler": "^4.136.3"
  }
}
