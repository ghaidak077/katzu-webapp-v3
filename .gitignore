
!.vscode/extensions.json
# Local D1/content recovery dumps — carry a copy of a database, never source.
backups/
# Dependencies
# Editor & OS files
# Environment variables
# Local tooling / caches (never shipped)
# Logs
# Playwright artifacts
# Production build outputs
*.local
*.tsbuildinfo
.DS_Store
.claude/
.env
.env.development.local
.env.local
.env.production.local
.env.test.local
.idea
.pnp
.pnp.js
.vitest/
.vscode/*
.wrangler/
/blob-report/
/playwright-report/
/test-results/
Thumbs.db
bun.lock
dist
dist-ssr
isolate/
lerna-debug.log*
node_modules
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Verification cost log: machine-local telemetry written by `npm run verify -- --cost`.
# Never committed - a log that dirties the tree on every run is a log people disable.
.verify-runs.ndjson

# Stray run logs and scratch dumps local tooling writes into the tree.
# A log that shows up in `git status` is a log that gets committed by accident.
.verify.log
.vite-dev.log
tsc-verify.txt
vitest-verify.txt
*.tmp.txt
