#!/bin/sh
# .githooks/pre-push — the whole local gate before anything leaves this machine.
#
# WHAT IT RUNS: `npm run verify -- --cost`
#   both typechecks, the unit suite (including every doc, index, registration and budget guard),
#   `node --check` over every worker and script, the design audit and the contrast check. It records
#   the run's cost (seconds per step) to the gitignored `.verify-runs.ndjson`, which
#   `npm run cost:report` reads back.
#
# WHAT IT DOES NOT RUN: the Playwright suite — a five-minute build-and-browse on every push is a hook
# that gets bypassed. It is `npm run verify -- --e2e` locally, `docs/agent/DEPLOY.md` requires it
# before a deploy, and CI runs it on every push and PR. So the browser suite is always triggered;
# it is just not in this hook's critical path.
#
# RED MEANS NO PUSH. Fix it, or state why you are bypassing with `git push --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
npm run --silent verify -- --cost
