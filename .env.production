# Production build shape: the guided home is the shipped home.
# Per-device kill switch: localStorage['kz.guidedHome'] = '0'.
# Revert this build without a device switch by setting VITE_GUIDED_HOME=0 here.
VITE_GUIDED_HOME=1

# Canonical public app origin. The build derives the static canonical link,
# og:url, absolute share images, JSON-LD, robots.txt sitemap URL and
# sitemap.xml <loc> values from this one value.
VITE_PUBLIC_APP_URL=https://katzuai.com

# The Worker origin every API call targets. Public by design (it ships in the
# bundle) and required: without it the client refuses every request with
# WORKER_URL_MISSING. It lives here, not only in the Pages dashboard, because a
# manual `wrangler pages deploy dist` bypasses the dashboard build environment —
# that is how a bundle with an empty origin reached production on 2026-10-27.
# Keep in sync with `ALLOWED_ORIGINS` in wrangler.toml.
VITE_WORKER_URL=https://katzu-test.ghaidakalosh008.workers.dev

