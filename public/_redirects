# Legacy legal URLs. The canonical trust pages are the generated /trust/* pages.
/privacy /trust/privacy 301
/privacy/ /trust/privacy 301
/terms /trust/terms 301
/terms/ /trust/terms 301

# SPA routes. Generating 404.html makes Cloudflare Pages serve it for every
# unmatched path, which would break React Router deep links. Rewrite the real
# client-side routes to the shell first; the generated public pages above are
# static files and are deliberately not listed here, so an unknown public path
# still reaches 404.html.
/app / 200
/app/* / 200
/main / 200
/main/* / 200
/scenario/* / 200
/welcome / 200
/signin / 200
/demo / 200
/onboarding / 200
/subscription / 200
/paywall / 200
/mock / 200
/placement / 200
/session-report / 200
/delete-account / 200
